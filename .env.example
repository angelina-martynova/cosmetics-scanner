# ─────────────────────────────────────────────────────────────────
# Cosmetics Scanner / Skipley — приклад змінних оточення.
# Скопіюйте у .env та заповніть. Файл .env у git не потрапляє (.gitignore).
# ─────────────────────────────────────────────────────────────────

# Оточення застосунку: development | production | testing
APP_ENV=development

# Секретний ключ Flask (підпис сесій).
# ОБОВ'ЯЗКОВО задати для APP_ENV=production — інакше застосунок не стартує.
# Згенерувати:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Підключення до БД.
# development: можна лишити порожнім — використається локальний SQLite.
# production:  ОБОВ'ЯЗКОВО, напр.:
#   postgresql://cosmetics_app:ВАШ_ПАРОЛЬ@localhost:5432/cosmetics_db
DATABASE_URL=

# ── Мережа / запуск ──
PORT=5001
# ПРАВИЛО: GUNICORN_WORKERS і RATELIMIT_STORAGE_URI мають узгоджуватись.
# GUNICORN_WORKERS > 1  =>  RATELIMIT_STORAGE_URI ОБОВ'ЯЗКОВО redis://...
# (з memory:// кожен воркер матиме окремий лічильник лімітів).
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# ── Rate limiting (Flask-Limiter) ──
# memory:// підходить ЛИШЕ для одного воркера. Для GUNICORN_WORKERS > 1 або
# кількох інстансів — спільне сховище: redis://localhost:6379
# (розкоментуйте redis у requirements.txt). Застосунок пише попередження
# при старті, якщо це налаштовано неправильно.
RATELIMIT_STORAGE_URI=memory://
# Ліміти у форматі Flask-Limiter (рядки).
SCAN_DAILY_LIMIT=20 per day
AUTH_RATE_LIMIT=5 per minute
EXTERNAL_SEARCH_LIMIT=10 per minute
